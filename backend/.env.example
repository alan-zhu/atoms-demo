# ─── LLM 配置（开启 AI 生成模式）─────────────────────────────
# 填了 OPENAI_API_KEY → 前端自动显示 "AI 生成" 按钮
# 不填（默认）          → 走现有模板路径

OPENAI_API_KEY=

# 以下为可选自定义，不填则用默认值
# LLM_API_BASE=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# 兼容其他 OpenAI Compatible 服务：
# LLM_API_BASE=https://你的中转地址/v1
# LLM_MODEL=qwen-plus
